{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/link-worktree-local-files.sh\"",
            "timeout": 30,
            "statusMessage": "Linking local-only files into worktree..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/format-on-edit.sh\"",
            "timeout": 90,
            "statusMessage": "Formatting the edited file with its repo's tools..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/judge-status.sh\"",
            "timeout": 60,
            "statusMessage": "Judge status: publishing the verdict as a commit status..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/judge-gate.sh\"",
            "timeout": 7200,
            "statusMessage": "Judge gate: lock check, suite, then the judge..."
          }
        ]
      }
    ]
  }
}
